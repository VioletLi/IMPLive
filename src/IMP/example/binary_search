a := [1, 3, 4, 6, 7, 9, 11];
target := 7;
lo := 0;
hi := a.length - 1;
found := 0-1;
while lo <= hi do
    mid := (lo + hi) / 2;
    if a[mid] == target then
        found := mid;
        lo := hi + 1
    else
        if a[mid] < target then
            lo := mid + 1
        else
            hi := mid - 1
        end
    end
end;
print found